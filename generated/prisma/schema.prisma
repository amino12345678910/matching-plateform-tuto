generator client {
  provider = "prisma-client-js"
  // engineType = "client" // No rust engines
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum imageSources {
  GOOGLE
  CLOUDINARY
  NULL
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  imageSource   imageSources @default(NULL)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  hasPassword   Boolean      @default(true)
  sessions      Session[]
  accounts      Account[]
  seller        Seller?
  reviews       Review[]

  clientConversations     Conversation[] @relation("ClientConversations")
  freelancerConversations Conversation[] @relation("FreelancerConversations")

  clientBookings     Booking[] @relation("ClientBooking")
  freelancerBookings Booking[] @relation("FreelancerBooking")
  services           Service[]

  @@unique([email])
  @@index([id])
  @@index([hasPassword])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Services table

model Seller {
  id           String       @id @default(uuid())
  bio          String?
  profilePhoto String?
  imageSource  imageSources @default(NULL)
  isVerified   Boolean      @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  services Service[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seller")
}

model ServicePackage {
  id          String      @id @default(uuid())
  name        PackageTier
  price       Float
  delivery    Int
  revisions   Int
  description String

  serviceId String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
}

model Tag {
  id         String    @id @default(uuid())
  name       String
  slug       String    @unique
  isApproved Boolean   @default(false)
  services   Service[]

  @@map("tags")
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  services Service[]

  @@index([slug])
  @@map("category")
}

model Review {
  id      String  @id @default(uuid())
  rating  Int
  comment String?

  userId    String @unique
  serviceId String @unique

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([userId])
  @@map("review")
}

model Faq {
  id        String @id @default(uuid())
  question  String
  answer    String
  serviceId String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@map("faq")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  images      String[]

  sellerId     String
  freelancerId String
  categoryId   String

  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  freelancer User     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  faqs     Faq[]
  packages ServicePackage[]
  tags     Tag[]
  reviews  Review[]
  bookings Booking[]

  status    ServiceStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([title])
  @@index([description])
  @@index([slug])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("service")
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  REJECTED
}

// Booking system
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  IN_REVIEW
  DISPUTED
}

model Booking {
  id                 String      @id @default(uuid())
  serviceId          String
  clientId           String
  freelancerId       String
  servicePackageTier PackageTier
  revisions          Int         @default(1)
  delivery           Int         @default(1)

  seller     Seller  @relation(fields: [sellerId], references: [id])
  client     User    @relation("ClientBooking", fields: [clientId], references: [id])
  freelancer User    @relation("FreelancerBooking", fields: [freelancerId], references: [id])
  service    Service @relation(fields: [serviceId], references: [id])

  hasSeen      DateTime?
  revisedCount Int           @default(1) // number of revisions has happened
  status       BookingStatus @default(PENDING)
  totalPrice   Float
  acceptedAt   DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sellerId      String
  conversations Conversation[]

  @@unique([serviceId, clientId])
  @@index([serviceId, clientId])
  @@index([freelancerId])
  @@index([clientId])
  @@index([clientId, freelancerId])
  @@index([createdAt])
  @@map("booking")
}

/// Messages
model Message {
  id          String      @id @default(uuid())
  roomId      String
  senderId    String
  text        String
  contentType MessageType
  linkedUrls  String[]
  createdAt   DateTime    @default(now())

  conversation Conversation @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, senderId])
  @@map("message")
}

enum MessageType {
  AUTOMATED
  NORMAL
  FILE
}

model Conversation {
  id           String @id // roomId (sorted userId--sellerUserId)
  clientId     String
  bookingId    String
  freelancerId String

  client     User    @relation("ClientConversations", fields: [clientId], references: [id])
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  freelancer User    @relation("FreelancerConversations", fields: [freelancerId], references: [id])

  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([bookingId])
  @@index([clientId])
  @@index([freelancerId])
  @@map("conversation")
}
